{
  "name": "ai-office",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "桌面端 AI Office 工具(VSCode 风格文件树 + office 文件预览 + AI 修改)",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "yarn workspace web dev",
    "dev": "concurrently -k -n server,web -c blue,green \"yarn dev:server\" \"yarn dev:web\"",
    "build:server": "tsc -p tsconfig.node.json",
    "build:web": "yarn workspace web build",
    "build": "yarn build:web && yarn build:server",
    "serve": "node dist/server.js",
    "stage:resources": "node scripts/stage-resources.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && yarn workspace web typecheck",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@aipack-ai/agent": "^1.3.1",
    "@officecli/officecli": "^1.0.144"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^20.12.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "resolutions": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "packageManager": "yarn@1.22.22"
}
