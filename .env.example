# ── LLM 配置 ──────────────────────────────────────
# LLM 提供商(deepseek/openai/anthropic/google/groq 等)
LLM_PROVIDER=deepseek
# 模型 id(留空按 provider 取默认)
LLM_MODEL=

# 至少配置一个 API Key
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=

# ── 后端 ───────────────────────────────────────────
# 开发模式后端端口(Vite proxy /api 到此端口)
PORT=3001

# ── 工作区(可选)──────────────────────────────────
# 默认 ./office-workspace;桌面端会用原生目录选择器覆盖
# OFFICE_WORKSPACE=office-workspace
